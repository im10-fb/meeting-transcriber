# meeting-transcriber secrets. Variables already set in your shell take precedence.

# Speech to text (required): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# The key for the llm.provider in config.yaml. Only that one is needed.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# FIREWORKS_API_KEY=
# TOGETHER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# LLM_API_KEY=             # provider: openai-compatible

# provider: vertex. A service account key file is the most reliable option;
# without one, gcloud's application default credentials are used.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=     # defaults to the key file's project
# GOOGLE_CLOUD_LOCATION=global
